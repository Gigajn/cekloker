# Salin ke .env — JANGAN commit file .env asli
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cekloker
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_BUCKET=loker-snapshots
JWT_SECRET=changeme-ganti-di-server
# Adapter yang aktif di Fase 1-lanjutan (pisah koma).
# JobStreet TIDAK aktif (ToS SEEK melarang agregasi — D6, ADR-0001).
ENABLED_SOURCES=glints,kalibrr
# Kontak jujur untuk User-Agent scraper (wajib diisi sebelum dipakai live)
CEKLOKER_CONTACT=
# Akun admin seed (hanya lewat env, JANGAN tulis nilai asli di sini)
CEKLOKER_ADMIN_EMAIL=
CEKLOKER_ADMIN_PASSWORD=
# Jeda sopan antar request per domain (detik)
SCRAPER_DELAY_SECONDS=3
